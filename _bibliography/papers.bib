@article{bohnstingl2022biologically,
  tldr={Backpropagation through time is ill-suited to online learning, since it must store every past neural state. We show that e-prop, a local, biologically inspired approximation of it, can train recurrent spiking neural networks online on neuromorphic hardware, with performance competitive with full-precision training.},
  author={Bohnstingl, Thomas and Surina, Anja and Fabre, Maxime and Demira{\u{g}}, Yi{\u{g}}it and Frenkel, Charlotte and Payvand, Melika and Indiveri, Giacomo and Pantazi, Angeliki},
  journal={IEEE AICAS}, 
  title={Biologically-Inspired Training of Spiking Recurrent Neural Networks with Neuromorphic Hardware}, 
  year={2022},
  keywords={Training;Phase change materials;Neuromorphics;Computational modeling;In-memory computing;Hardware;Inference algorithms;online training;spiking neural networks;neuromorphic hardware;in-memory computing;phase-change memory},
  pdf = {https://ieeexplore.ieee.org/document/9869963}
}
