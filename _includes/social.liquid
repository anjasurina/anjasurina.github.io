{% assign social_list = site.data.socials %}

<ul class="contact-list">
  {% if social_list.email %}
  <li>
    <span class="contact-icon" aria-hidden="true">{% include icons/envelope-simple.svg %}</span>
    <a class="email-link" data-user="{{ social_list.email.user }}" data-domain="{{ social_list.email.domain }}">{{ social_list.email.name }}</a>
    <script>
      document.querySelectorAll('.email-link').forEach((a) => {
        a.href = 'mailto:' + a.dataset.user + '@' + a.dataset.domain;
      });
    </script>
  </li>
  {% endif %}

  {% if social_list.googlescholar %}
  <li>
    <span class="contact-icon" aria-hidden="true">{% include icons/graduation-cap.svg %}</span>
    <a href="{{ social_list.googlescholar.link }}">{{ social_list.googlescholar.name }}</a>
  </li>
  {% endif %}

  {% if social_list.semanticscholar %}
  <li>
    <i class="ai ai-semantic-scholar"></i>
    <a href="{{ social_list.semanticscholar.link }}">{{ social_list.semanticscholar.name }}</a>
  </li>
  {% endif %}

  {% if social_list.github %}
  <li>
    <span class="contact-icon" aria-hidden="true">{% include icons/github-logo.svg %}</span>
    <a href="{{ social_list.github.link }}">{{ social_list.github.name }}</a>
  </li>
  {% endif %}

  {% if social_list.linkedin %}
  <li>
    <span class="contact-icon" aria-hidden="true">{% include icons/linkedin-logo.svg %}</span>
    <a href="{{ social_list.linkedin.link }}">{{ social_list.linkedin.name }}</a>
  </li>
  {% endif %}

  {% if social_list.twitter %}
  <li>
    <span class="contact-icon" aria-hidden="true">{% include icons/x-logo.svg %}</span>
    <a href="{{ social_list.twitter.link }}">{{ social_list.twitter.name }}</a>
  </li>
  {% endif %}

  {% if social_list.cv %}
  <li>
    <i class="fas fa-file"></i>
    <a href="{{ social_list.cv.link }}">{{ social_list.cv.name }}</a>
  </li>
  {% endif %}
</ul>
