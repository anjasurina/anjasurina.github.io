@article{falck2026training,
  tldr={Replicating a paper demands the same hypothesis-driven exploration as open-ended research, making it a training ground for research taste. Trained on this task with long-horizon RL, our 27B-parameter AI scientist, Faraday, outperforms frontier agents Claude Opus 4.8 and GPT-5.5 at replicating research, a step toward models capable of autonomous innovation.},
  title={Training AI Scientists to Replicate Research},
  author={Falck, Damon and Sabri, Samer and Surina, Anja and Foster, Thom and Sims, Anya and Devlin, Sam and Rogers, Dylan and Collins, Tantum and Aleksiev, Kaloyan and Kirsch, Louis and Hughes, Edward},
  journal={arXiv},
  year={2026},
  url={https://arxiv.org/abs/2608.13331},
  pdf={https://arxiv.org/pdf/2608.13331},
  blog={https://inherentlabs.ai/research/training-to-replicate},
}

@article{davidson2026futurefacts,
  tldr={Language models are fast becoming our default interface to facts, yet what they recognize as true often differs from what they can recall. We trace how this generation-verification gap emerges and evolves over a fact's lifecycle. Our findings call for rethinking how we measure factuality in language models. As more training data from the web is written by models themselves, the gap also risks a quiet drift in what counts as usable knowledge.},
  title={The Future of Facts: Tracing the Factual Generation-Verification Gap},
  author={Davidson*, Tim R. and Surina*, Anja and Gulcehre, Caglar},
  journal={NeurIPS},
  year={2026},
  url={https://arxiv.org/abs/2605.27564},
  pdf={https://arxiv.org/pdf/2605.27564},
  blog={https://www.trdavidson.com/fact-gap},
  code={https://github.com/anjasurina/factgap},
  secondary_venue={COLM},
  secondary_year={2026},
  secondary_info={Scientific Understanding of Foundation Models Workshop},
  award={Oral},
  award_name={Oral}
}

@article{tsoukalas2026advancing,
  tldr={We developed AlphaProof Nexus, Google DeepMind's Gemini-powered agent for formal proof search. It autonomously solved 9 open Erdős problems (two of them open for 56 years) and advanced research-level mathematics across various fields, with every proof verified in Lean.},
  title={Advancing Mathematics Research with AI-Driven Formal Proof Search},
  author={Tsoukalas, George and Kovsharov, Anton and Shirobokov, Sergey and Surina, Anja and Firsching, Moritz and B{\'e}rczi, Gergely and Ruiz, Francisco J. R. and Suggala, Arun and Wagner, Adam Zsolt and Wieser, Eric and Yu, Lei and Huang, Aja and Horv{\'a}th, Mikl{\'o}s Z. and Ferraiuolo, Andrew and Michalewski, Henryk and Lockhart, Edward and Grosu, Codrut and Hubert, Thomas and Balog, Matej and Kohli, Pushmeet and Chaudhuri, Swarat},
  journal={arXiv},
