  url={https://arxiv.org/abs/2605.22763},
  pdf={https://arxiv.org/pdf/2605.22763},
  code={https://github.com/google-deepmind/alphaproof-nexus-results},
}

@article{surina2026improved,
  tldr={Using AlphaProof Nexus, we resolved an open question in min-max optimization by proving that Anchored Gradient Descent Ascent achieves the faster O(1/t) rate. The agent autonomously discovered both the proof and the new step-size schedule that makes it work, verified in Lean.},
  title={An Improved Last-Iterate Convergence Rate for Anchored Gradient Descent Ascent},
  author={Surina, Anja and Suggala, Arun and Tsoukalas, George and Kovsharov, Anton and Shirobokov, Sergey and Ruiz, Francisco J. R. and Kohli, Pushmeet and Chaudhuri, Swarat},
  journal={arXiv},
  year={2026},
  url={https://arxiv.org/abs/2604.03782},
  pdf={https://arxiv.org/pdf/2604.03782},
  note={Results later incorporated into the <strong>Advancing Mathematics Research with AI-Driven Formal Proof Search</strong> paper}
}

@article{surina2025algorithm,
  tldr={We developed EvoTune, which uses reinforcement learning to let an LLM learn from its own discoveries during evolutionary search. By training the model to become a better search operator, EvoTune finds better algorithms faster than AlphaEvolve-style search with a fixed LLM, a step toward self-improving LLMs for algorithm design.},
  title={Algorithm Discovery With {LLM}s: Evolutionary Search Meets Reinforcement Learning},
  author={Anja Surina and Amin Mansouri and Lars Quaedvlieg and Amal Seddas and Maryna Viazovska and Emmanuel Abbe and Caglar Gulcehre},
