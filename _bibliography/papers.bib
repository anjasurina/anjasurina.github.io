@article{nilforoshan2023zero,
  tldr={We developed CaML, a causal meta-learning framework that predicts the personalized effects of a novel intervention, such as a newly invented drug, without ever seeing that intervention during training. On large-scale patient records and cell-line perturbation data, its zero-shot predictions outperform even baselines trained directly on data from the new intervention.},
  title={Zero-Shot Causal Learning},
  author={Nilforoshan, Hamed and Moor, Michael and Roohani, Yusuf and Chen, Yining and Surina, Anja and Yasunaga, Michihiro and Oblak, Sara and Leskovec, Jure},
